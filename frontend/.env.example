# Copy this file to `.env` inside frontend/ if you want to bake in a default
# backend URL at build time. This is optional — the app also lets you type
# the backend's Server URL into the Kotak login panel at runtime, which is
# then remembered in the browser's localStorage/cookie, so most deployments
# (e.g. the Vercel + separate VM split described in the root README) don't
# need this file at all.
VITE_API_BASE_URL=http://localhost:8080
