# Copy this file to `.env` in the repo root (next to trades.db) and fill in
# the values you need. `.env` is auto-loaded at server startup (via dotenvy)
# and is gitignored — never commit your real secrets.
#
# Anything already exported in your shell, or set via a systemd
# EnvironmentFile=, takes priority over this file.

# ── Auth (required) ─────────────────────────────────────────────────────
# Gates the entire app. Every /api/* request (except /api/health and the
# passkey-verify endpoint itself) needs a bearer token issued by exchanging
# this passkey at POST /api/auth/verify-passkey. Pick a long random value.
PASSKEY=

# HMAC-SHA256 secret used to sign/verify that bearer token. Pick a separate
# long random value (e.g. `openssl rand -hex 32`) — do not reuse PASSKEY.
AUTH_SECRET=

# ── SQLite ───────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite://trades.db

# ── Logging (optional) ────────────────────────────────────────────────────
# Standard tracing-subscriber env filter, e.g. "info", "debug", or
# "server=debug,kotak_client=info".
RUST_LOG=info

# ── Telegram MTProto ingester (optional) ──────────────────────────────────
# Only needed to auto-start the ingester at boot. Omitted, you can still log
# in step-by-step from the frontend's Telegram login panel at runtime.
# Get API ID/hash from https://my.telegram.org -> API Development Tools.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
# Comma-separated chat IDs to listen to (use a negative number for groups).
TELEGRAM_CHAT_IDS=-1001234567890,-1009876543210

# ── Kotak Neo — market data WebSocket ─────────────────────────────────────
# Scrips to subscribe on connect (pSymbol from the scrip master, & separated).
# KOTAK_SCRIPS=nse_cm|11536

# ── Kotak Neo — auto-login (optional) ─────────────────────────────────────
# Set all five (access token, mobile, UCC, MPIN, TOTP secret) to skip the
# manual Kotak login form. When present, the server will:
#  - log in automatically at startup if no valid session is restored from
#    the DB (sessions expire daily), and
#  - retry once more at 09:00 IST every trading day if still not connected.
# The 6-digit TOTP is generated from KOTAK_TOTP_SECRET (RFC 6238) at login
# time, so nobody has to read a code off an authenticator app each morning.
#
# WARNING: this brings the account online — and, in LIVE trading mode, able
# to place real orders on incoming Telegram signals — with no human action
# required that day. Leave these unset (or set KOTAK_AUTO_LOGIN=false) if you
# want every trading day to start with a manual Connect click instead.
KOTAK_ACCESS_TOKEN=          # API Dashboard access token
KOTAK_MOBILE_NUMBER=         # registered mobile, with country code, e.g. +91XXXXXXXXXX
KOTAK_UCC=                   # Unique Client Code, e.g. Y4HAU
KOTAK_MPIN=                  # 6-digit trading MPIN
KOTAK_TOTP_SECRET=           # Base32 secret from TOTP registration (alias: KOTAK_TOTP_HASH)
KOTAK_AUTO_LOGIN=true        # set to "false" to disable unattended auto-login even if the above are set
