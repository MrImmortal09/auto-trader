# Auto-Trader Backend Environment Variables
# -----------------------------------------

# Security
# MUST be exactly 6 digits (e.g., 123456)
PASSKEY=123456

# Secret key used for signing JWT tokens. 
# Make this a long random string in production.
AUTH_SECRET=your_super_secret_jwt_key_here

# Database
# The SQLite database path. Default is sqlite://trades.db
DATABASE_URL=sqlite://trades.db

# Kotak Neo API
# The scrips to subscribe to via WebSocket. Default is nse_cm|11536 (Nifty 50 or similar)
KOTAK_SCRIPS=nse_cm|11536

# Telegram (Optional - used for ingesting trade signals)
# Get these from https://my.telegram.org
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=your_telegram_api_hash
# TELEGRAM_CHAT_IDS=-100123456789,-100987654321
